{
  "name": "protege-mi-dni",
  "version": "1.0.0",
  "description": "Crea una copia protegida de tu DNI en el navegador: en blanco y negro, con los datos privados tapados y una marca de agua con la finalidad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-handlebars": "^2.0.0",
    "wrangler": "^4.112.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
