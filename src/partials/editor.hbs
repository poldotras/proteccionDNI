<section id="pasos">
	<p class="centrado" id="ZonaElegir"><button class="btn BotonPrincipal" type="button" id="ElegirFoto"><span>Elige la foto</span></button></p>
	<div id="DivFichero"><input type="file" id="SelectorFichero" accept="image/*" title="Selector de foto (no visible)" tabindex="-1" aria-hidden="true"></div>
	<div id="Edicion" class="Oculto">
		<div id="OpcionesEdicion">
			<div><label for="Formato">Tipo de foto</label> <select id="Formato"></select></div>
			<div id="DivValidez" class="CampoCheckbox Oculto"><label for="Validez">Ocultar Fecha de Nacimiento, Validez y Nº Soporte</label> <span><input type="checkbox" id="Validez"> <a href="index.html#OcultarNumeroSoporte" target="_blank" data-ayuda="OcultarNumeroSoporte" class="AbrirInfo">¿qué es esto?</a></span></div>
			<div id="DivMascaraDni" class="CampoCheckbox Oculto"><label for="EnmascararDni">Ocultar parcialmente el DNI</label> <span><input type="checkbox" id="EnmascararDni"> <a href="index.html#OcultarParcialmente" target="_blank" data-ayuda="OcultarParcialmente" class="AbrirInfo">¿qué es esto?</a></span></div>
			<div class="ContenedorControl"><label for="Watermark">Finalidad de la copia</label> <input type="text" id="Watermark" placeholder="Ejemplo: Válido solo para el alta de suministro con Comercializadora Luz del Norte"></div>
		</div>
		<div id="Vistas">
			<div id="PanelOriginal">
				<div class="TituloVista">Original: arrastra los 4 puntos a las esquinas del DNI</div>
				<div id="EditorEsquinas">
					<canvas id="canvasOriginal" width="1000" height="625"></canvas>
					<svg id="MarcoEsquinas" viewBox="0 0 1000 625">
						<polygon id="PoligonoEsquinas" points="0,0"></polygon>
						<circle class="esquina" data-indice="0" r="18"></circle>
						<circle class="esquina" data-indice="1" r="18"></circle>
						<circle class="esquina" data-indice="2" r="18"></circle>
						<circle class="esquina" data-indice="3" r="18"></circle>
						<circle class="esquina ZonaToque" data-indice="0" r="50"></circle>
						<circle class="esquina ZonaToque" data-indice="1" r="50"></circle>
						<circle class="esquina ZonaToque" data-indice="2" r="50"></circle>
						<circle class="esquina ZonaToque" data-indice="3" r="50"></circle>
					</svg>
					<canvas id="Lupa" width="300" height="300"></canvas>
				</div>
				<div id="ControlesOriginal">
					<button type="button" class="IconoAccion Oculto" id="DetectarDNI" title="Buscar los bordes del DNI en la foto"><svg viewBox="0 0 24 24"><path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" /></svg></button>
					<button type="button" class="IconoAccion Oculto" id="DeshacerDeteccion" title="Deshacer la detección y volver a la imagen completa"><svg viewBox="0 0 24 24"><path d="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" /></svg></button>
					<button type="button" class="IconoAccion girar" title="Girar a Izquierda" data-giro="-90"><svg viewBox="0 0 24 24"><path d="M13 4.07V1L8.45 5.55 13 10V6.09a6 6 0 0 1 0 11.82v2.02a7.99 7.99 0 0 0 0-15.86M7.1 18.32a7.92 7.92 0 0 0 3.9 1.61V17.9a5.91 5.91 0 0 1-2.46-1.03L7.1 18.32M6.09 13H4.07a7.9 7.9 0 0 0 1.62 3.89l1.41-1.42A6 6 0 0 1 6.09 13m1.02-4.47L5.7 7.11A7.92 7.92 0 0 0 4.07 11h2.02c.14-.87.49-1.72 1.02-2.47Z" /></svg></button>
					<button type="button" class="IconoAccion girar" title="Girar a Derecha" data-giro="90"><svg viewBox="0 0 24 24"><path d="m16.89 15.5 1.42 1.39A7.9 7.9 0 0 0 19.93 13h-2.02a6.08 6.08 0 0 1-1.02 2.5M13 17.9v2.02a7.92 7.92 0 0 0 3.9-1.61l-1.44-1.44c-.75.54-1.59.89-2.46 1.03m6.93-6.9a7.9 7.9 0 0 0-1.62-3.89l-1.42 1.42c.54.75.88 1.6 1.02 2.47m-2.36-5.45L11 1v3.07a8 8 0 0 0 0 15.86v-2.02a6 6 0 0 1 0-11.82V10l4.55-4.45Z" /></svg></button>
				</div>
			</div>
			<div id="PanelResultado">
				<div class="TituloVista">Copia protegida</div>
				<div id="Previsualizacion">
					<canvas id="canvas" width="1000" height="625"></canvas>
				</div>
			</div>
		</div>
		<p class="centrado" id="ZonaGuardar">
			<button class="btn BotonPrincipal" type="button" id="Guardar"><span>Guardar<svg viewBox="0 0 24 24" role="presentation"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg></span></button>
			<button class="btn BotonPrincipal" type="button" id="Compartir"><span>Compartir<svg viewBox="0 0 24 24" role="presentation"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7 0-.24-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 003-3 3 3 0 00-3-3 3 3 0 00-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9a3 3 0 00-3 3 3 3 0 003 3c.79 0 1.5-.31 2.04-.81l7.12 4.15c-.05.21-.08.43-.08.66 0 1.61 1.31 2.91 2.92 2.91 1.61 0 2.92-1.3 2.92-2.91A2.92 2.92 0 0018 16.08z" /></svg></span></button>
		</p>
		<a id="grabar"></a>
	</div>
</section>
<!-- respuestas de la portada que se muestran como popover en los enlaces de ayuda -->
<div class="Oculto">
	<div id="OcultarNumeroSoporte">
		<div class="respuesta">
			<p>
				Estos datos os los pueden solicitar para hacer un "check-in" en alojamientos y verificar que el DNI está en vigor según el Real Decreto 933/2021.
				En ocasiones el dato de Nº Soporte puede ser útil para verificar que no es un DNI falsificado, y por eso también puede ser necesario dejarlo visible.
			</p>
		</div>
	</div>
	<div id="OcultarParcialmente">
		<div class="respuesta">
			<p>
				Seguramente no necesitarás activar esta opción. En el número de DNI se ocultan las 3 primeras y 2 últimas cifras según la orientación
				para la aplicación provisional de la disposición adicional septima de la LOPDGDD.
			</p>
		</div>
	</div>
</div>
